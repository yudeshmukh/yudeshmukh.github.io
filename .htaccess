#Options +Indexes
#IndexOptions FancyIndexing SuppressHTMLPreamble
#SuppressLastModified SuppressSize

HeaderName .hearder.html

AddIcon /icons/folder.gif ^^DIRECTORY
AddIcon /icons/unknown.gif ^^DEFAULT


<IfModule mod_rewrite.c>
    RewriteEngine On
    # Redirect requests for the target file to the external URL
    RewriteRule ^nearby_cocores\.pdf$ https://arxiv.org/abs/2511.09548 [R=301,L]
</IfModule>
